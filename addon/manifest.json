{
  "manifest_version": 2,
  "name": "Zotero 元数据更新",
  "version": "0.4.0",
  "description": "按条目已有 URL 或唯一标识符获取最新元数据，逐项审核后安全更新并留痕",
  "author": "iiwenwen",
  "icons": {
    "48": "content/icons/favicon@0.5x.png",
    "96": "content/icons/favicon.png"
  },
  "applications": {
    "zotero": {
      "id": "zmta-update-metadata@local",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
